#include <stdio.h>
#include <ctype.h>
int main () {
	int ul,ll,round=0,mid;
	char a;
	printf("Welcome to Number Guessing Software.\nThis software will be guessing the number between the range you provide.\n");
	printf("Rules:\n");
	printf("If the number displayed is smaller than that guessing number, Enter H\n");
	printf("If the number displayed is larger than that guessing number, Enter L\n");
	printf("If the number displayed is same as the guessing number, Enter Y\n");
	printf("Please enter the lowest possible value of your range: ");
	scanf("%d",&ll);
	printf("Please enter the highest possible value of your range: ");
	scanf("%d",&ul);
	
	if (ll > ul) {
		printf("I told you to give the lowest possible value first.");
	} else {
		while (true) {
			printf("Range: (%d,%d)\n",ll,ul);
			mid = (ll+ul)/2;
			printf("Is your number %d?\nEnter your answer:",mid);
			scanf(" %c",&a);
			printf("\n");
			if (toupper(a)=='H') {
				ll = mid + 1;
				mid = (ll+ul)/2;
				round += 1;
			} else if (toupper(a)=='L') {
				ul = mid;
				mid = (ll+ul)/2;
				round += 1;
			} else if (toupper(a)=='Y') {
				printf("So the number you choose was %d\n",mid);
				printf("Thank You for Playing This Game\n");
				printf("Total Guesses Made: %d",round);
				break;
			} else {
				printf("Enter a valid input\n");
			}
		}
	}
	return 0;
}
